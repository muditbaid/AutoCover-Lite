# Free-tier API keys. Copy to .env (gitignored) and fill in the ones you have; the router
# skips models whose provider has no key. Never put real keys in this file.
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_NIM_API_KEY=
OPENROUTER_API_KEY=

# Optional: send OpenTelemetry traces to Jaeger (docker compose up -d jaeger)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
